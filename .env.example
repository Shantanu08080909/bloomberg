# OpenFinance Terminal configuration.
# Copy this file to .env.local and edit. Never commit .env.local.
# Every variable is optional: with none set, the app runs in demo mode on an
# embedded PostgreSQL database stored in ./data/pglite.

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use embedded PostgreSQL (PGlite, no install).
# Set it to use a PostgreSQL server instead, e.g. the one in docker-compose.yml:
# DATABASE_URL=postgres://openfinance:change-me@localhost:5432/openfinance
DATABASE_URL=
# Folder for the embedded database (ignored when DATABASE_URL is set).
PGLITE_DIR=./data/pglite
DATABASE_POOL_MAX=10

# --- Accounts and sessions -------------------------------------------------
# There are no default credentials: the first visitor creates the owner account.
# Set to true to allow additional people to register.
ALLOW_REGISTRATION=false
SESSION_TTL_DAYS=14
# auto = Secure cookies only when the request is HTTPS. Use true behind HTTPS.
COOKIE_SECURE=auto

# --- Market data -------------------------------------------------------------
# auto (default): use imported NSE/BSE end-of-day data when any exists, otherwise demo.
# demo | eod | alphavantage force one source. Demo data is synthetic and always labelled DEMO.
MARKET_DATA_SOURCE=auto

# --- NSE / BSE end-of-day files (see docs/EOD_DATA.md) -------------------------
# Manual import (Data Provider Status → Import files, or `npm run eod -- import <files>`)
# always works. Automated download is OFF until you review the exchanges' terms of use.
EOD_DOWNLOAD_ENABLED=false
# With downloads on, the scheduler fetches new sessions once a day after this IST time.
EOD_AUTO_UPDATE=true
EOD_PUBLISH_AFTER_IST=19:00
EOD_EXCHANGES=NSE,BSE
# Also fetch the NSE index closing file (NIFTY indices). Index data is owned by NSE Indices Ltd.
EOD_NSE_INDICES=true
# Politeness: seconds between requests, and the largest backfill per run.
EOD_MIN_INTERVAL_SECONDS=3
EOD_MAX_DAYS_PER_RUN=60
# Override if the exchanges change their file locations (placeholders: {YYYYMMDD} {DDMMYYYY} {YYYY} {MON} {MM} {DD}).
# EOD_NSE_UDIFF_URL=https://nsearchives.nseindia.com/content/cm/BhavCopy_NSE_CM_0_0_0_{YYYYMMDD}_F_0000.csv.zip
# EOD_NSE_LEGACY_URL=https://archives.nseindia.com/content/historical/EQUITIES/{YYYY}/{MON}/cm{DD}{MON}{YYYY}bhav.csv.zip
# EOD_NSE_INDEX_URL=https://nsearchives.nseindia.com/content/indices/ind_close_all_{DDMMYYYY}.csv
# EOD_BSE_UDIFF_URL=https://www.bseindia.com/download/BhavCopy/Equity/BhavCopy_BSE_CM_0_0_0_{YYYYMMDD}_F_0000.CSV
# Allow CSV export of imported exchange data (only if your use permits redistribution).
EOD_EXPORT_ALLOWED=false
# Optional third-party archive (TejHQ, NSE 2010→, BSE 2024-07→). Read docs/EOD_DATA.md first.
TEJ_ARCHIVE_ENABLED=false
# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=
# BSE symbols to track, comma separated (adapter requests SYMBOL.BSE)
ALPHAVANTAGE_SYMBOLS=
# Requests per day your plan allows
ALPHAVANTAGE_DAILY_LIMIT=25
# How Alpha Vantage prices are labelled: eod | delayed
ALPHAVANTAGE_DATA_STATUS=eod

# --- Economic data -----------------------------------------------------------
# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=
FRED_SERIES=FEDFUNDS,CPIAUCSL,DGS10,DGS2,UNRATE,DEXINUS

# --- News ----------------------------------------------------------------------
# Comma-separated RSS/Atom feed URLs that you are permitted to use.
NEWS_RSS_FEEDS=

# --- Freshness (when real data is labelled STALE) ----------------------------
STALE_AFTER_MINUTES_LIVE=15
STALE_AFTER_MINUTES_DELAYED=60
STALE_AFTER_HOURS_EOD=96

# --- Background scheduler (alert checks, provider refreshes) -----------------
SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_SECONDS=60

# --- Optional email for alerts -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
